#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer W { float w[]; };
layout(std430, binding = 1) buffer G { float g[]; };
layout(std430, binding = 2) buffer M { float m[]; };
layout(std430, binding = 3) buffer V { float v[]; };

layout(push_constant) uniform PC {
  uint u0;
  uint u1;
  uint u2;
  uint u3;
  uint u4;
  uint u5;
  float f0;
  float f1;
  float f2;
  float f3;
  float f4;
  float f5;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.u0) return;
  float gi = g[i];
  float mi = pc.f1 * m[i] + (1.0 - pc.f1) * gi;
  float vi = pc.f2 * v[i] + (1.0 - pc.f2) * gi * gi;
  m[i] = mi;
  v[i] = vi;
  float mhat = mi / pc.f4;
  float vhat = vi / pc.f5;
  w[i] -= pc.f0 * mhat / (sqrt(vhat) + pc.f3);
}
