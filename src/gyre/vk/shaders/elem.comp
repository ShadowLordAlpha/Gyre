#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer X { float x[]; };
layout(std430, binding = 1) buffer Y { float y[]; };
layout(std430, binding = 2) buffer Z { float z[]; };

layout(push_constant) uniform PC {
  uint u0;
  uint u1;
  uint u2;
  uint u3;
  uint u4;
  uint u5;
  float f0;
  float f1;
  float f2;
  float f3;
  float f4;
  float f5;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  uint n = pc.u0;
  uint op = pc.u1;
  uint cols = pc.u2;
  if (i >= n) return;
  const float c = 0.044715;
  const float s = 0.7978845608028654;
  if (op == 0u) {
    z[i] = x[i] + y[i];
  } else if (op == 1u) {
    z[i] = x[i] * y[i];
  } else if (op == 2u) {
    float v = clamp(x[i], -40.0, 40.0);
    float u = s * (v + c * v * v * v);
    z[i] = 0.5 * v * (1.0 + tanh(u));
  } else if (op == 3u) {
    float xv = clamp(x[i], -40.0, 40.0);
    float u = s * (xv + c * xv * xv * xv);
    float th = tanh(u);
    float du = s * (1.0 + 3.0 * c * xv * xv);
    float dgelu = 0.5 * (1.0 + th) + 0.5 * xv * (1.0 - th * th) * du;
    z[i] = y[i] * dgelu;
  } else if (op == 4u) {
    z[i] = x[i] * pc.f0;
  } else if (op == 5u) {
    z[i] = pc.f0;
  } else if (op == 6u) {
    z[i] += x[i];
  } else if (op == 7u) {
    z[i] = x[i];
  } else if (op == 8u) {
    z[i] = x[i] / (1.0 + exp(-x[i]));
  } else if (op == 9u) {
    z[i] = pc.f0 * tanh(x[i] / pc.f0);
  } else if (op == 10u) {
    z[i] = x[i] + y[i % cols];
  }
}
