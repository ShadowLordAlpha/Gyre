#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer S0 { float s0[]; };
layout(std430, binding = 1) buffer S1 { float s1[]; };
layout(std430, binding = 2) buffer S2 { float s2[]; };
layout(std430, binding = 3) buffer S3 { float s3[]; };
layout(std430, binding = 4) buffer S4 { uint s4u[]; };
layout(std430, binding = 5) buffer S5 { uint s5u[]; };
layout(std430, binding = 6) buffer II { int ii[]; };

layout(push_constant) uniform PC {
  uint u0;
  uint u1;
  uint u2;
  uint u3;
  uint u4;
  uint u5;
  float f0;
  float f1;
  float f2;
  float f3;
  float f4;
  float f5;
} pc;

shared float red[256];

// Every invocation reads red[0] into a local, then a barrier runs before
// returning. Without it a fast thread could start the next reduce_* call and
// overwrite red[0] while a slower one has not read the previous result yet.
float reduce_max(float v) {
  red[gl_LocalInvocationID.x] = v;
  barrier();
  for (uint s = 128u; s > 0u; s >>= 1u) {
    if (gl_LocalInvocationID.x < s)
      red[gl_LocalInvocationID.x] = max(red[gl_LocalInvocationID.x], red[gl_LocalInvocationID.x + s]);
    barrier();
  }
  float r = red[0];
  barrier();
  return r;
}

float reduce_sum(float v) {
  red[gl_LocalInvocationID.x] = v;
  barrier();
  for (uint s = 128u; s > 0u; s >>= 1u) {
    if (gl_LocalInvocationID.x < s) red[gl_LocalInvocationID.x] += red[gl_LocalInvocationID.x + s];
    barrier();
  }
  float r = red[0];
  barrier();
  return r;
}

float qnan() { return uintBitsToFloat(0x7fc00000u); }

bool bit_nan(float x) {
  return (floatBitsToUint(x) & 0x7fffffffu) > 0x7f800000u;
}

bool bit_pinf(float x) { return floatBitsToUint(x) == 0x7f800000u; }

void main() {
  uint row = gl_WorkGroupID.x;
  uint lid = gl_LocalInvocationID.x;
  uint cols = pc.u1;
  uint op = pc.u2;
  uint rows = pc.u0;

  // LayerNorm gamma/beta grads, pass 2 of 3 (pass 1 is op 3). No atomics: one
  // invocation per (column, chunk of u3 rows) sums its rows in ascending order,
  // so the result never depends on GPU scheduling. Row stats (mean, inv) come
  // from op 3 in s4u. u4 != 0: there is a single chunk, and s2/s3 ARE gw/gb, so
  // start from their current value (accumulate, same order as the CPU loop).
  // Otherwise s2/s3 are [chunks, cols] partials that op 8 folds in.
  if (op == 7u) {
    uint col = gl_WorkGroupID.x * 256u + lid;
    if (col >= cols) return;
    uint chunk = gl_WorkGroupID.y;
    uint r0 = chunk * pc.u3;
    uint r1 = min(rows, r0 + pc.u3);
    uint o = chunk * cols + col;
    float dw = pc.u4 != 0u ? s2[o] : 0.0;
    float db = pc.u4 != 0u ? s3[o] : 0.0;
    for (uint r = r0; r < r1; ++r) {
      float mean = uintBitsToFloat(s4u[2u * r]);
      float inv = uintBitsToFloat(s4u[2u * r + 1u]);
      float g = s1[r * cols + col];
      float xhat = (s0[r * cols + col] - mean) * inv;
      dw += g * xhat;
      db += g;
    }
    s2[o] = dw;
    s3[o] = db;
    return;
  }

  // Pass 3: gw/gb (s4u/s5u as float bits) += chunk partials s2/s3 [u0 chunks,
  // cols], folded in ascending chunk order.
  if (op == 8u) {
    uint col = gl_WorkGroupID.x * 256u + lid;
    if (col >= cols) return;
    float dw = uintBitsToFloat(s4u[col]);
    float db = uintBitsToFloat(s5u[col]);
    for (uint k = 0u; k < rows; ++k) {
      dw += s2[k * cols + col];
      db += s3[k * cols + col];
    }
    s4u[col] = floatBitsToUint(dw);
    s5u[col] = floatBitsToUint(db);
    return;
  }

  if (op == 6u) {
    float sm = 0.0;
    for (uint i = lid; i < cols; i += 256u) sm += s0[i];
    sm = reduce_sum(sm);
    if (lid == 0u) s1[0] = sm * pc.f1;
    return;
  }

  if (row >= rows) return;
  uint base = row * cols;

  if (op == 0u) {
    float m = -1.0e30;
    for (uint i = lid; i < cols; i += 256u) m = max(m, s0[base + i]);
    m = reduce_max(m);
    if (bit_pinf(m)) {
      float ninf = 0.0;
      for (uint i = lid; i < cols; i += 256u)
        if (bit_pinf(s0[base + i])) ninf += 1.0;
      ninf = reduce_sum(ninf);
      float u = 1.0 / max(ninf, 1.0);
      for (uint i = lid; i < cols; i += 256u)
        s1[base + i] = bit_pinf(s0[base + i]) ? u : 0.0;
      return;
    }
    if (bit_nan(m)) {
      float u = 1.0 / float(cols);
      for (uint i = lid; i < cols; i += 256u) s1[base + i] = u;
      return;
    }
    float sm = 0.0;
    for (uint i = lid; i < cols; i += 256u) {
      float e = exp(s0[base + i] - m);
      s1[base + i] = e;
      sm += e;
    }
    sm = reduce_sum(sm);
    if (sm <= 0.0 || bit_nan(sm) || bit_pinf(sm)) {
      float u = 1.0 / float(cols);
      for (uint i = lid; i < cols; i += 256u) s1[base + i] = u;
      return;
    }
    for (uint i = lid; i < cols; i += 256u) s1[base + i] /= sm;
    return;
  }

  if (op == 1u) {
    float dot = 0.0;
    for (uint i = lid; i < cols; i += 256u) dot += s0[base + i] * s1[base + i];
    dot = reduce_sum(dot);
    for (uint i = lid; i < cols; i += 256u) s2[base + i] = s0[base + i] * (s1[base + i] - dot);
    return;
  }

  if (op == 2u) {
    float mean = 0.0;
    for (uint i = lid; i < cols; i += 256u) mean += s0[base + i];
    mean = reduce_sum(mean) / float(cols);
    float var = 0.0;
    for (uint i = lid; i < cols; i += 256u) {
      float d = s0[base + i] - mean;
      var += d * d;
    }
    var = reduce_sum(var) / float(cols);
    float inv = inversesqrt(var + pc.f0);
    for (uint i = lid; i < cols; i += 256u)
      s3[base + i] = (s0[base + i] - mean) * inv * s1[i] + s2[i];
    return;
  }

  if (op == 3u) {
    float mean = 0.0;
    for (uint i = lid; i < cols; i += 256u) mean += s0[base + i];
    mean = reduce_sum(mean) / float(cols);
    float var = 0.0;
    for (uint i = lid; i < cols; i += 256u) {
      float d = s0[base + i] - mean;
      var += d * d;
    }
    var = reduce_sum(var) / float(cols);
    float inv = inversesqrt(var + pc.f0);
    float sdx = 0.0;
    float sdxh = 0.0;
    for (uint i = lid; i < cols; i += 256u) {
      float xhat = (s0[base + i] - mean) * inv;
      float dxhat = s1[base + i] * s2[i];
      sdx += dxhat;
      sdxh += dxhat * xhat;
    }
    sdx = reduce_sum(sdx);
    sdxh = reduce_sum(sdxh);
    float invC = inv / float(cols);
    for (uint i = lid; i < cols; i += 256u) {
      float xhat = (s0[base + i] - mean) * inv;
      float dxhat = s1[base + i] * s2[i];
      s3[base + i] = invC * (float(cols) * dxhat - sdx - xhat * sdxh);
    }
    // Row stats for the gamma/beta pass (op 7), which reuses this exact xhat.
    if (lid == 0u) {
      s4u[2u * row] = floatBitsToUint(mean);
      s4u[2u * row + 1u] = floatBitsToUint(inv);
    }
    return;
  }

  if (op == 4u) {
    float m = -1.0e30;
    for (uint i = lid; i < cols; i += 256u) m = max(m, s0[base + i]);
    m = reduce_max(m);
    int t = ii[row];
    if (bit_pinf(m) || bit_nan(m)) {
      if (lid == 0u) s2[row] = qnan();
      for (uint i = lid; i < cols; i += 256u) s1[base + i] = 0.0;
      return;
    }
    float sm = 0.0;
    for (uint i = lid; i < cols; i += 256u) sm += exp(s0[base + i] - m);
    sm = reduce_sum(sm);
    if (sm <= 0.0 || bit_nan(sm) || bit_pinf(sm)) {
      if (lid == 0u) s2[row] = qnan();
      for (uint i = lid; i < cols; i += 256u) s1[base + i] = 0.0;
      return;
    }
    if (lid == 0u) {
      float pt = 1e-12;
      if (t >= 0 && t < int(cols)) pt = max(exp(s0[base + uint(t)] - m) / sm, 1e-12);
      s2[row] = -log(pt);
    }
    barrier();
    float scale = pc.f1;
    for (uint i = lid; i < cols; i += 256u) {
      float p = exp(s0[base + i] - m) / sm;
      if (int(i) == t) p -= 1.0;
      s1[base + i] = p * scale;
    }
    return;
  }

  if (op == 5u) {
    float ms = 0.0;
    for (uint i = lid; i < cols; i += 256u) ms += s0[base + i] * s0[base + i];
    ms = reduce_sum(ms) / float(cols);
    float inv = inversesqrt(ms + pc.f0);
    for (uint i = lid; i < cols; i += 256u) s2[base + i] = s0[base + i] * inv * s1[i];
  }
}
