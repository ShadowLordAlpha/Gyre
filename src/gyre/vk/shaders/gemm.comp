#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) buffer C { float c[]; };

layout(push_constant) uniform PC {
  uint u0;
  uint u1;
  uint u2;
  uint u3;
  uint u4;
  uint u5;
  float f0;
  float f1;
  float f2;
  float f3;
  float f4;
  float f5;
} pc;

shared float As[16][16];
shared float Bs[16][16];

void main() {
  uint bm = gl_WorkGroupID.y;
  uint bn = gl_WorkGroupID.x;
  uint bat = gl_WorkGroupID.z;
  uint M = pc.u0, K = pc.u1, N = pc.u2, batch = pc.u3;
  if (bat >= batch) return;
  uint tx = gl_LocalInvocationID.x;
  uint ty = gl_LocalInvocationID.y;
  uint row = bm * 16u + ty;
  uint col = bn * 16u + tx;
  float acc = 0.0;
  uint aOff = bat * M * K;
  uint bOff = bat * K * N;
  uint cOff = bat * M * N;
  uint tiles = (K + 15u) / 16u;
  for (uint t = 0u; t < tiles; ++t) {
    uint aCol = t * 16u + tx;
    uint bRow = t * 16u + ty;
    As[ty][tx] = (row < M && aCol < K) ? a[aOff + row * K + aCol] : 0.0;
    Bs[ty][tx] = (bRow < K && col < N) ? b[bOff + bRow * N + col] : 0.0;
    barrier();
    for (uint k = 0u; k < 16u; ++k) acc += As[ty][k] * Bs[k][tx];
    barrier();
  }
  if (row < M && col < N) c[cOff + row * N + col] = acc;
}
